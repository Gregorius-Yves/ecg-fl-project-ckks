FROM golang:1.22-bookworm AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /ckks-sidecar ./cmd/sidecar

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /ckks-sidecar /usr/local/bin/ckks-sidecar
EXPOSE 9090
ENTRYPOINT ["ckks-sidecar"]
CMD ["-port", "9090"]
